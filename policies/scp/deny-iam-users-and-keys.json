{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyLocalIamUsersAndLongLivedKeys",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreateLoginProfile",
        "iam:UpdateLoginProfile",
        "iam:CreateAccessKey"
      ],
      "Resource": "*"
    }
  ]
}
