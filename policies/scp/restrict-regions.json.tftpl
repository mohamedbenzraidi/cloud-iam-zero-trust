{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOutsideAllowedRegions",
      "Effect": "Deny",
      "NotAction": [
        "a4b:*", "account:*", "acm:*", "aws-portal:*", "budgets:*", "ce:*", "cloudfront:*",
        "cur:*", "globalaccelerator:*", "health:*", "iam:*", "identitystore:*",
        "organizations:*", "pricing:*", "route53:*", "route53domains:*", "shield:*",
        "sso:*", "sso-directory:*", "sts:*", "support:*", "tag:*", "trustedadvisor:*",
        "waf:*", "wafv2:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": { "aws:RequestedRegion": ${regions} }
      }
    }
  ]
}
